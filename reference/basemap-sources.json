  "cameraPolicy": "No setView/fitBounds from module initialization/theme change/fallback; existing Leaflet camera controls remain sole owner.",
  "analyticalPolicy": "Module only uses tilePane below all analytical vectors and outsideMask; no CSSfilter or transformed colors applied to dataset layers.",
  "attribution": [
    "OpenFreeMap",
    "OpenMapTiles",
    "OpenStreetMap contributors"
  ],
  "integration": {
    "css": "basemap.css",
    "classicScriptBeforeApp": "basemap.js",
    "factory": "SilaBasemap.create({theme:S.theme,language:S.lang,fallback:true}).addTo(S.map)",
    "events": [
      "basemapstatus",
      "tileerror",
      "basemapfallback",
      "load"
    ],
    "cleanup": "S.map.removeLayer(S.tile); S.tile.off();",
    "methods": [
      "setTheme(theme)",
      "setLanguage(lang)",
      "getMaplibreMap()",
      "getBasemapState()"
    ],
    "sameMapInstance": true,
    "cssPolicy": {
      "scope": "MapLibre map-container overflow/position and canvas position only; noninteractive canvas ignores pointer events. Leaflet owns navigation and attribution. No MapLibre controls or popups are mounted.",
      "sourceVersion": "maplibre-gl 6.12.0",
      "fullVendorCSSRetainedUnchanged": true,
      "fullVendorCSSLinked": false,
      "fullVendorCSSSHA256": "8456072adc2cbf04f7b845bc83b90cec571b293bd37816970e6566f34946ab8b",
      "subsetSHA256": "86a4786d559c6400be986d9fb560095922d2a1eaa7ca1773deaa64ca62f916ea",
      "licenseFile": "vendor/maplibre-gl/LICENSE.txt"
    }
  },
  "verificationBoundary": "Public metadata and pinned package tarball SHA512 checks verified. Native WebGL viewport, zoom/pan/overlay and deployment behavior require root browser QA; not claimed by this module alone."
