{
  "schemaVersion": "sila.basemap_sources/2.0",
  "checkedOn": "2026-10-06",
  "provider": "OpenFreeMap",
  "officialIntegrationGuide": "https://openfreemap.org/quick_start/",
  "officialBridgeDocumentation": "https://github.com/maplibre/maplibre-gl-leaflet",
  "dark": {
    "styleUrl": "https://tiles.openfreemap.org/styles/dark",
    "nativeTheme": true
  },
  "light": {
    "styleUrl": "https://tiles.openfreemap.org/styles/liberty",
    "nativeTheme": true
  },
  "labelPolicy": "Retain native style name:nonlatin expressions alongside Latin names. Thai appears where the underlying OSM vector tile has a non-Latin local name; this does not certify every label in Thai.",
  "zoomBenefit": "Vector road/place labels and geometry are rendered at the current zoom rather than enlarging a fixed raster tile. The Leaflet bridge retains existing layer/drilldown APIs; it does not add pitch/rotation.",
  "requiresWebGL": true,
  "fallback": {
    "provider": "OpenStreetMap raster",
    "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "maxNativeZoom": 19,
    "nativeTheme": false,
    "mustLabel": "OpenStreetMap raster fallback",
    "policy": "https://operations.osmfoundation.org/policies/tiles/",
    "triggers": [
      "local module/bridge load or WebGL initialization failure",
      "WebGL context loss",
      "startup exceeding15seconds"
    ],
    "failureBehavior": "No provider fallback silently called quiet/dark. Analytical layers and scope remain available. Individual vector resource error surfaces tileerror without forcing provider replacement."
  },
